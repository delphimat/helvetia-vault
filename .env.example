# ==========================================
# Project Helvetia Vault - Environment Setup
# ==========================================

# 1. MongoDB Atlas Configuration
# Ensure the database user has 'readWrite' permissions for the PoC.
# Use an M0 or M10 cluster located in the EU/Switzerland region.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority"

# 2. AI & Embedding Providers
# Voyage AI for highly accurate financial vector embeddings
VOYAGE_API_KEY="your_voyage_api_key_here"
# OpenAI for the Generative (LLM) portion of the RAG pipeline
OPENAI_API_KEY="your_openai_api_key_here"

# 3. Client-Side Field Level Encryption (CSFLE)
# This is the 96-byte base64-encoded Local Master Key.
# DO NOT commit the real key to source control.
ENCRYPTION_KEY="your_base64_encoded_96_byte_key_here"